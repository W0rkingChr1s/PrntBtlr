[Unit]
Description=PrntBtlr scan-button listener (Canon PIXMA USB interrupt)
Documentation=https://github.com/w0rkingchr1s/prntbtlr
After=multi-user.target
# The listener reads the scanner's USB interrupt endpoint directly; scanbd
# polling the same device would fight it for access. Only one may run at a time.
Conflicts=scanbd.service

[Service]
Type=simple
EnvironmentFile=-/etc/prntbtlr/prntbtlr.env
# Uses the system python3 (with python3-usb / pyusb), not the app venv, and
# needs raw USB access — hence root, like the rest of PrntBtlr.
ExecStart=/usr/bin/python3 /opt/prntbtlr/scan-listen.py
Restart=on-failure
RestartSec=3

# --- Sandboxing -----------------------------------------------------------
# Same idea as prntbtlr.service: keep root (raw USB), drop the rest. The
# filesystem is read-only except the scan folder (scan2pdf.sh writes there;
# adjust when SCAN_DIR is changed). PrivateDevices stays OFF for /dev/bus/usb.
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=-/srv/scans
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
# UNIX for local IPC, IPv4/6 for the scan.completed webhook, netlink for glibc.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK

[Install]
WantedBy=multi-user.target
